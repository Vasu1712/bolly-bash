# Turso (libSQL) database that stores every pass, so a character can only be claimed once
# across all guests and devices.
#   turso db create bolly-bash
#   turso db show bolly-bash --url
#   turso db tokens create bolly-bash
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
